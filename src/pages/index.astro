---
import '@fontsource/jetbrains-mono/500.css';
import Base from '../layouts/Base.astro';
import '../styles/one-show.css';

import Nav from '../components/Nav.astro';
import Quotes from '../components/Quotes.astro';
import WhoFor from '../components/WhoFor.astro';
import Close from '../components/Close.astro';
import Footer from '../components/Footer.astro';
import OneShow from '../components/one-show/OneShow';
import { Icon } from '../components/icons';
import { HERO, LINKS } from '../data/site';

const title = 'Beckstage · Where live music works';
// The hero's sub, so the two never read differently.
const description = HERO.sub.join(' ');
---
<Base title={title} description={description} path="/">
    {/* Pricing and the FAQ used to be sections of this page: their old links land on /pricing. */}
    <script is:inline>
      (function () {
        var h = location.hash;
        if (h === '#pricing') location.replace('/pricing');
        else if (h === '#faq') location.replace('/pricing#faq');
      })();
    </script>

    <header class="hv2 hv4">
      <Nav bar="hero" />
      <div class="bk-wrap hv4-copy">
        <h1 class="bk-h1">{HERO.h1[0]} <em>{HERO.h1[1]}</em> {HERO.h1[2]}</h1>
        <p class="hv2-sub"><span>{HERO.sub[0]}</span> <span>{HERO.sub[1]}</span></p>
        <div class="hv4-ctas">
          <a class="bk-btn bk-btn-lg bk-btn-onDark plausible-event-name=Signup+hero" href={LINKS.signup}>{HERO.primary}<Icon name="arrow" size={18} color="#fff" /></a>
        </div>
      </div>
    </header>

    <main>
      <OneShow client:idle />
      <Quotes />
      <WhoFor />
      <Close />
    </main>

    <Footer />
</Base>
